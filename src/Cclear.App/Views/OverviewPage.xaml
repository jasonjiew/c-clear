<UserControl x:Class="Cclear.App.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Cclear.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16" MaxWidth="1280">

            <!--  标题与磁盘概况  -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="C 盘空间" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DriveDetail}" Margin="14,2,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!--  第一行：健康分 / 磁盘环形图 / 快速操作  -->
            <UniformGrid Columns="3" Margin="0,14,0,0">

                <ui:Card Margin="0,0,8,0" MinHeight="190">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="HeartPulse24" Margin="0,0,8,0"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="C 盘健康分" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{Binding HealthScoreText}" FontSize="52" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{Binding HealthScoreValue, Converter={StaticResource HealthScoreToBrush}}" />
                            <StackPanel Margin="12,6,0,0" VerticalAlignment="Center">
                                <TextBlock Text="/ 100" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="8,2" Margin="0,4,0,0" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding HealthScoreLevel}" FontWeight="SemiBold"
                                               Foreground="{Binding HealthScoreValue, Converter={StaticResource HealthScoreToBrush}}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding HealthScoreSummary}" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LastCleanText}" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="8,0" MinHeight="190">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid Width="150" Height="150">
                            <controls:RingGauge Percent="{Binding UsedPercent}" StrokeWidth="13"
                                                TrackBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                ValueBrush="{DynamicResource AccentFillColorDefaultBrush}" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding UsedPercentText}" FontSize="26" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="已使用" FontSize="12" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="总容量" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding TotalBytesText}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="已用" FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding UsedBytesText}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="剩余" FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding FreeBytesText}" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="8,0,0,0" MinHeight="190">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Flash24" Margin="0,0,8,0"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="快速操作" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:Button Appearance="Primary" Content="一键体检" Icon="{ui:SymbolIcon Search24}"
                                   Command="{Binding HealthCheckCommand}" MinWidth="180" MinHeight="38"
                                   FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Left" />
                        <ui:Button Content="深度分析（大文件 / 类型统计）" Icon="{ui:SymbolIcon DataUsage24}"
                                   Command="{Binding DeepScanCommand}" MinHeight="34" Margin="0,8,0,0"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding PlanSummaryText}" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <!--  第二行：清理趋势（F2） + OneDrive 云占位（F5）  -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Card Grid.Column="0" Margin="0,0,8,0" MinHeight="150">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="History24" Margin="0,0,8,0"
                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="清理趋势（最近 30 天）" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding TrendSummaryText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                                Margin="0,10,0,0" Padding="6" MinHeight="92">
                            <Grid>
                                <controls:TrendChart Values="{Binding TrendValues}" MinHeight="88"
                                                     LineBrush="{DynamicResource AccentFillColorDefaultBrush}" />
                                <StackPanel Visibility="{Binding HasTrendData, Converter={StaticResource BoolToInvisibility}}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="ChartMultiple24" FontSize="30"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="完成首次清理后，这里将展示最近 30 天的释放量趋势。"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="1" Margin="8,0,0,0" MinHeight="150">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Cloud24" Margin="0,0,8,0"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="OneDrive 云占位" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                                Margin="0,10,0,0" Padding="14" MinHeight="92">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Cloud24" FontSize="26" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{Binding CloudStatsText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           TextAlignment="Center" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" MaxWidth="300" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!--  大文件 Top 50  -->
            <ui:Card Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Document24" Margin="0,0,8,0"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="大文件 Top 50（≥100 MB）" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListView ItemsSource="{Binding LargeFiles}" MaxHeight="280" Margin="0,10,0,0"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                                <GridViewColumn Header="文件" Width="820" DisplayMemberBinding="{Binding Path}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </ui:Card>

            <!--  类型统计 Top 15  -->
            <ui:Card Margin="0,14,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DataUsage24" Margin="0,0,8,0"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="空间占用类型排行（Top 15）" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListView ItemsSource="{Binding Extensions}" MaxHeight="280" Margin="0,10,0,0"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="类型" Width="140" DisplayMemberBinding="{Binding Extension}" />
                                <GridViewColumn Header="占用" Width="110" DisplayMemberBinding="{Binding TotalText}" />
                                <GridViewColumn Header="文件数" Width="100" DisplayMemberBinding="{Binding Count}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </ui:Card>

            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,0,0,8" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
