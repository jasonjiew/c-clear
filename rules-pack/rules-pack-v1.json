{"schemaVersion":1,"packVersion":1,"sha256":"d65c36003faa0fb04081febf1708cbede55226900ec30f0b40ef4edc327ba214","rules":[{"id":"cargo-registry-cache","name":"Cargo registry 缓存","level":"Caution","paths":["%USERPROFILE%\\.cargo\\registry\\cache"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":[],"explanation":"crates.io 下载缓存（.crate 文件）；重建代价：重新构建时重新下载。只动 registry\\cache，不动 registry\\src 与已安装工具","reportOnly":false,"shellAction":false,"cli":null},{"id":"chrome-cache","name":"Chrome 浏览器缓存","level":"Safe","paths":["%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Cache","%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Code Cache","%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\GPUCache"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":["chrome"],"explanation":"网页缓存；重建代价：重新访问网页时重新下载。绝不触碰密码/登录数据/Cookie/收藏/历史；Chrome 运行中自动跳过","reportOnly":false,"shellAction":false,"cli":null},{"id":"crash-dumps","name":"应用崩溃转储","level":"Safe","paths":["%LOCALAPPDATA%\\CrashDumps","C:\\Windows\\MEMORY.DMP","C:\\Windows\\Minidump\\*"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":[],"explanation":"应用崩溃时生成的调试转储文件，一般用户几乎不会用到；系统级转储（C:\\Windows 下）需以管理员身份运行本程序","reportOnly":false,"shellAction":false,"cli":null},{"id":"d3dscache","name":"DirectX 着色器缓存","level":"Safe","paths":["%LOCALAPPDATA%\\D3DSCache"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":[],"explanation":"DirectX 自动管理的着色器缓存，删除后首次运行游戏时会自动重建（可能短暂变慢）","reportOnly":false,"shellAction":false,"cli":null},{"id":"delivery-opt","name":"传递优化缓存（仅报告）","level":"Caution","paths":["C:\\Windows\\ServiceProfiles\\NetworkService\\AppData\\Local\\Microsoft\\Windows\\DeliveryOptimization\\Cache"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":true,"preconditionProcesses":[],"explanation":"P2P 更新分发缓存，需要 SYSTEM 权限；本程序不直接删除，请在 PowerShell 中运行 Delete-DeliveryOptimizationCache -Force，或使用 系统设置 > 存储 > 临时文件","reportOnly":true,"shellAction":false,"cli":null},{"id":"docker-system","name":"Docker 悬空资源","level":"Caution","paths":[],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":[],"explanation":"不直接删除任何 Docker 文件；执行官方命令 docker system prune -f（仅清理悬空镜像/停止容器/无用网络，不动卷）。Docker 未运行或未安装时自动跳过。注意：不清理卷（-v 才会动卷）","reportOnly":false,"shellAction":false,"cli":{"command":"docker","args":"system prune -f"}},{"id":"edge-cache","name":"Edge 浏览器缓存","level":"Safe","paths":["%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Cache","%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Code Cache","%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\GPUCache"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":["msedge"],"explanation":"网页缓存；重建代价：重新访问网页时重新下载。绝不触碰密码/登录数据/Cookie/收藏/历史；Edge 运行中自动跳过","reportOnly":false,"shellAction":false,"cli":null},{"id":"firefox-cache","name":"Firefox 浏览器缓存","level":"Safe","paths":["%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles\\*\\cache2"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":["firefox"],"explanation":"网页缓存；重建代价：重新访问网页时重新下载。绝不触碰密码/Cookie/书签/历史；Firefox 运行中自动跳过","reportOnly":false,"shellAction":false,"cli":null},{"id":"gradle-caches","name":"Gradle 依赖缓存","level":"Caution","paths":["%USERPROFILE%\\.gradle\\caches"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":[],"explanation":"仅清理 caches 子目录（构建缓存与依赖），不动 .gradle 其他内容；重建代价：下次构建重新下载全部依赖，可能耗时数分钟到数十分钟","reportOnly":false,"shellAction":false,"cli":null},{"id":"huggingface-cache","name":"HuggingFace 模型缓存","level":"Caution","paths":["%USERPROFILE%\\.cache\\huggingface"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":[],"explanation":"已下载的模型/数据集缓存；重建代价：模型可能数 GB，重新下载非常耗时，请确认不再使用的模型再清理","reportOnly":false,"shellAction":false,"cli":null},{"id":"jetbrains-caches","name":"JetBrains IDE 缓存与日志","level":"Caution","paths":["%LOCALAPPDATA%\\JetBrains\\*\\caches","%LOCALAPPDATA%\\JetBrains\\*\\log"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":["idea64","pycharm64","webstorm64","clion64","goland64","rider64","datagrip64"],"explanation":"索引/反编译缓存与日志；重建代价：重新打开项目需重新建立索引（大项目数十分钟）。IDE 运行中会自动跳过","reportOnly":false,"shellAction":false,"cli":null},{"id":"maven-repository","name":"Maven 本地仓库","level":"Caution","paths":["%USERPROFILE%\\.m2\\repository"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":[],"explanation":"仅清理 repository 依赖目录，绝不触碰 settings.xml；重建代价：下次构建重新下载全部依赖","reportOnly":false,"shellAction":false,"cli":null},{"id":"npm-cache","name":"npm 缓存","level":"Caution","paths":["%LOCALAPPDATA%\\npm-cache"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":[],"explanation":"npm 包下载缓存；重建代价：重新安装依赖时需重新下载（视网速数分钟）。优先执行官方命令 npm cache clean --force，npm 不在 PATH 时回退目录删除","reportOnly":false,"shellAction":false,"cli":{"command":"npm","args":"cache clean --force"}},{"id":"nuget-packages","name":"NuGet 包缓存","level":"Caution","paths":["%USERPROFILE%\\.nuget\\packages"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":[],"explanation":"NuGet 全局包目录；重建代价：还原（restore）时重新下载。优先官方命令 dotnet nuget locals all --clear（同时清理 http 缓存）；dotnet 不在 PATH 时回退目录删除","reportOnly":false,"shellAction":false,"cli":{"command":"dotnet","args":"nuget locals all --clear"}},{"id":"pip-cache","name":"pip 缓存","level":"Caution","paths":["%LOCALAPPDATA%\\pip\\cache"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":[],"explanation":"pip 下载/wheel 缓存；重建代价：重新安装包时需重新下载构建。优先官方命令 pip cache purge","reportOnly":false,"shellAction":false,"cli":{"command":"pip","args":"cache purge"}},{"id":"pnpm-store","name":"pnpm 存储仓库","level":"Caution","paths":["%LOCALAPPDATA%\\pnpm\\store"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":[],"explanation":"pnpm 内容寻址存储；重建代价： prune 后未引用的包需重新下载。优先官方命令 pnpm store prune（保留仍被引用的包）；pnpm 不在 PATH 时回退目录删除（项目内为硬链接，删除存储不会破坏已安装依赖）","reportOnly":false,"shellAction":false,"cli":{"command":"pnpm","args":"store prune"}},{"id":"poetry-cache","name":"poetry 缓存","level":"Caution","paths":["%LOCALAPPDATA%\\pypoetry\\Cache"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":[],"explanation":"poetry 包缓存；重建代价：重新安装依赖时重新下载。优先官方命令 poetry cache clear","reportOnly":false,"shellAction":false,"cli":{"command":"poetry","args":"cache clear --all . --no-interaction"}},{"id":"recycle-bin","name":"清空回收站","level":"Caution","paths":[],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":[],"explanation":"回收站中已删除的文件，清空后不可通过回收站还原（但仍是经 Shell API 执行）；请确认里面没有还需要的东西","reportOnly":false,"shellAction":true,"cli":null},{"id":"thumbcache","name":"缩略图与图标缓存","level":"Safe","paths":["%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer\\thumbcache_*.db","%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer\\iconcache_*.db"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":[],"explanation":"资源管理器缩略图/图标缓存数据库，删除后会自动重建；被占用的文件自动跳过","reportOnly":false,"shellAction":false,"cli":null},{"id":"user-temp","name":"用户临时文件","level":"Safe","paths":["%TEMP%"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":3,"requiresAdmin":false,"preconditionProcesses":[],"explanation":"应用程序留下的临时文件；仅清理超过 72 小时未修改的文件，正在使用的文件会被自动跳过","reportOnly":false,"shellAction":false,"cli":null},{"id":"uv-cache","name":"uv 缓存","level":"Caution","paths":["%LOCALAPPDATA%\\uv\\cache"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":[],"explanation":"uv 包缓存；重建代价：重新安装包时重新下载。优先官方命令 uv cache clean","reportOnly":false,"shellAction":false,"cli":{"command":"uv","args":"cache clean"}},{"id":"vscode-cache","name":"VS Code 缓存","level":"Caution","paths":["%APPDATA%\\Code\\Cache","%APPDATA%\\Code\\CachedData","%APPDATA%\\Code\\Code Cache"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":["Code"],"explanation":"UI/代码缓存；重建代价：首次启动与打开项目稍慢。绝不触碰 User/globalStorage 与 workspaceStorage（含你的设置与扩展数据）；VS Code 运行中自动跳过","reportOnly":false,"shellAction":false,"cli":null},{"id":"wer-reports","name":"Windows 错误报告队列","level":"Safe","paths":["C:\\ProgramData\\Microsoft\\Windows\\WER\\ReportQueue","C:\\ProgramData\\Microsoft\\Windows\\WER\\ReportArchive"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":[],"explanation":"Windows 错误报告（WER）排队/归档的报告包，问题上报完成后即可清理","reportOnly":false,"shellAction":false,"cli":null},{"id":"win-update","name":"Windows 更新下载缓存","level":"Caution","paths":["C:\\Windows\\SoftwareDistribution\\Download"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":true,"preconditionProcesses":[],"explanation":"已下载的 Windows 更新安装包；清理时需要临时停止 Windows 更新服务，任一步失败会放弃并建议使用系统磁盘清理","reportOnly":false,"shellAction":false,"cli":null},{"id":"windows-logs","name":"Windows 系统日志（仅报告）","level":"Manual","paths":["C:\\Windows\\Logs"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":true,"preconditionProcesses":[],"explanation":"系统组件日志（CBS、DISM 等），排查系统问题时有用；本程序只报告大小，建议保留","reportOnly":true,"shellAction":false,"cli":null},{"id":"windows-old","name":"旧系统 Windows.old（仅报告）","level":"Manual","paths":["C:\\Windows.old"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":true,"preconditionProcesses":[],"explanation":"系统升级后的旧系统备份，可用于回退；请使用系统磁盘清理（清理系统文件）卸载，手动删除可能导致无法回退","reportOnly":true,"shellAction":false,"cli":null},{"id":"windows-temp","name":"Windows 系统临时文件","level":"Safe","paths":["C:\\Windows\\Temp"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":3,"requiresAdmin":true,"preconditionProcesses":[],"explanation":"Windows 与系统服务产生的临时文件；被占用的文件会自动跳过","reportOnly":false,"shellAction":false,"cli":null},{"id":"yarn-cache","name":"yarn 缓存","level":"Caution","paths":["%LOCALAPPDATA%\\Yarn\\Cache"],"expandAllUsers":false,"include":["*"],"exclude":[],"minAgeDays":0,"requiresAdmin":false,"preconditionProcesses":[],"explanation":"yarn 包缓存；重建代价：安装依赖时重新下载。优先官方命令 yarn cache clean","reportOnly":false,"shellAction":false,"cli":{"command":"yarn","args":"cache clean"}}]}
