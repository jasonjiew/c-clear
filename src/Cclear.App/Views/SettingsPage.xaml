<UserControl x:Class="Cclear.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="外观" FontSize="16" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="主题模式：" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding SelectedTheme}"
                          MinWidth="140" Margin="8,0,0,0" />
                <TextBlock Text="跟随系统将随 Windows 深浅色自动切换" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock Text="排除目录" FontSize="16" FontWeight="Bold" Margin="0,16,0,0" />
            <TextBlock Text="扫描与体检将跳过这些目录（子树整体排除）。" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,6" />
            <StackPanel Orientation="Horizontal">
                <TextBox Width="480" Text="{Binding NewExcludedDir, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" />
                <Button Content="添加" Command="{Binding AddExcludedDirCommand}" Margin="8,0,0,0"
                        MinWidth="72" MinHeight="28" />
            </StackPanel>
            <ListBox ItemsSource="{Binding ExcludedDirs}" Height="120" Margin="0,8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="移除" Command="{Binding DataContext.RemoveExcludedDirCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" MinWidth="56" />
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="删除方式" FontSize="16" FontWeight="Bold" Margin="0,16,0,4" />
            <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding PermanentDelete}" VerticalAlignment="Center" />
                <TextBlock Text="永久删除模式（默认关闭：删除进回收站可还原；开启后清理不进回收站且无法还原）"
                           Margin="8,0,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            </StackPanel>

            <TextBlock Text="审计日志" FontSize="16" FontWeight="Bold" Margin="0,16,0,4" />
            <StackPanel Orientation="Horizontal">
                <Button Content="打开日志文件夹" Command="{Binding OpenLogsFolderCommand}" MinWidth="120" MinHeight="28" />
                <TextBlock Text="{Binding LogsFolder}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="10,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <TextBlock Text="内置规则（只读）" FontSize="16" FontWeight="Bold" Margin="0,16,0,4" />
            <ListView ItemsSource="{Binding Rules}" Height="300"
                      VirtualizingStackPanel.IsVirtualizing="True">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" Width="150" DisplayMemberBinding="{Binding Id}" />
                        <GridViewColumn Header="名称" Width="170" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="级别" Width="56" DisplayMemberBinding="{Binding Level}" />
                        <GridViewColumn Header="路径 / 命令" Width="330">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Paths}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Paths}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
