<UserControl x:Class="Cclear.App.Views.Settings.SettingsGeneralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Margin="8" MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock Text="外观" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="主题模式立即生效并持久化；跟随系统将随 Windows 深浅色自动切换。"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,12" />
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="主题模式：" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                      MinWidth="150" MinHeight="34" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,14,0,0" />
    </StackPanel>
</UserControl>
