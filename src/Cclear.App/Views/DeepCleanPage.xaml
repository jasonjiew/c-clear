<UserControl x:Class="Cclear.App.Views.DeepCleanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16" MaxWidth="1080" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Sparkle24" FontSize="22" Margin="0,0,10,0"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                <TextBlock Text="深度清理引导" FontSize="26" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="对标“电脑管家深度清理”：只引导不代删。执行项均标注“是什么 / 为什么 / 代价”；需要管理员权限的操作会先检测并二次确认。"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,4" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="10,4">
                    <TextBlock Text="{Binding AdminStatusText}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Border>
            </StackPanel>

            <!--  卡 1：组件存储（WinSxS）分析  -->
            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ChartMultiple24" Margin="0,0,8,0"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="组件存储分析（WinSxS）" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding WinSxsSizeText}" Margin="12,0,0,0" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="是什么：Windows 组件存储保存系统文件的多个版本，随更新不断增长。为什么：分析可了解实际占用，是后续清理决策的依据。代价：只读分析，约 1–5 分钟，不做任何修改。"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,10" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="分析组件存储" Icon="{ui:SymbolIcon Search24}" Appearance="Primary"
                                   Command="{Binding AnalyzeWinSxsCommand}" MinWidth="130" />
                    </StackPanel>
                    <TextBox Text="{Binding WinSxsResultText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             MaxHeight="170" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"
                             Visibility="{Binding WinSxsResultText, Converter={StaticResource TextToVisibility}}"
                             Background="Transparent" BorderThickness="0" />
                </StackPanel>
            </ui:Card>

            <!--  卡 2：Windows 更新备份清理  -->
            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ShieldTask24" Margin="0,0,8,0"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="Windows 更新备份清理（DISM /StartComponentCleanup）" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="8,2" Margin="10,0,0,0">
                            <TextBlock Text="需管理员" FontSize="11" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="是什么：由微软官方 DISM 清理组件存储中被新版本取代的旧更新文件，通常可回收数 GB。为什么：这是系统盘最大的可回收项之一。代价：已安装的更新将无法卸载回滚；过程 10–30 分钟不可中断、请勿关机。"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,10" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="一键执行" Icon="{ui:SymbolIcon Broom24}" Appearance="Danger"
                                   Command="{Binding CleanupComponentsCommand}" MinWidth="110" />
                    </StackPanel>
                    <TextBox Text="{Binding CleanupResultText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             MaxHeight="170" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"
                             Visibility="{Binding CleanupResultText, Converter={StaticResource TextToVisibility}}"
                             Background="Transparent" BorderThickness="0" />
                </StackPanel>
            </ui:Card>

            <!--  卡 3：休眠文件  -->
            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="WeatherMoon24" Margin="0,0,8,0"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="休眠文件（hiberfil.sys）" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HibernationText}" Margin="12,0,0,0" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="是什么：hiberfil.sys 保存整机内存镜像以支持休眠与快速启动，通常为内存容量的 40%–100%。为什么：不用休眠功能时它纯属占用。代价：关闭后无法休眠、快速启动失效；随时可用 powercfg /h on 恢复。"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,10" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="关闭休眠并释放" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger"
                                   Command="{Binding DisableHibernationCommand}" MinWidth="150" />
                        <TextBlock Text="需管理员 · powercfg /h off（可随时恢复）" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!--  卡 4：系统还原点  -->
            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="History24" Margin="0,0,8,0"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="系统还原点占用" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="是什么：系统还原点与卷影副本（vShadow）占用的空间。为什么：还原点累积会占用数 GB 到数十 GB。代价：删除还原点后无法回滚到该时点；本页只引导，不代删——请走系统设置调整。"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,10" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="查询占用（需管理员）" Icon="{ui:SymbolIcon Info24}"
                                   Command="{Binding AnalyzeShadowStorageCommand}" MinWidth="150" />
                        <ui:Button Content="打开系统保护设置" Icon="{ui:SymbolIcon Settings24}"
                                   Command="{Binding OpenSystemProtectionCommand}" MinWidth="160" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBox Text="{Binding ShadowResultText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             MaxHeight="170" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"
                             Visibility="{Binding ShadowResultText, Converter={StaticResource TextToVisibility}}"
                             Background="Transparent" BorderThickness="0" />
                </StackPanel>
            </ui:Card>
            <!--  卡 5：卸载残留扫描（V3 P5，Pro 底座）  -->
            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Delete24" Margin="0,0,8,0"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="卸载残留扫描" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="4"
                                Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding LeftoverIsPro, Converter={StaticResource BoolToInvisibility}}">
                            <TextBlock Text="Pro" FontSize="11" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="是什么：应用卸载后残留在 AppData/ProgramData 里的孤儿数据目录。为什么：卸载程序通常不清理用户数据目录，日积月累占用可达数 GB。代价：勾选后进回收站可还原；已按注册表卸载登记过滤，最近 14 天有改动的目录（可能正在安装）自动排除；Program Files 内的受保护目录仅提示不提供删除。"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,10" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="扫描卸载残留" Icon="{ui:SymbolIcon Search24}" Appearance="Primary"
                                   Command="{Binding ScanLeftoversCommand}" MinWidth="130" />
                        <ui:Button Content="将勾选项目移入回收站" Icon="{ui:SymbolIcon Delete24}"
                                   Command="{Binding DeleteLeftoversCommand}" MinWidth="170" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding LeftoverStatusText}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding LeftoverSummaryText}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding LeftoverSummaryText, Converter={StaticResource TextToVisibility}}" />
                    <ListView ItemsSource="{Binding LeftoverRows}" MaxHeight="260" Margin="0,8,0,0"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasLeftoverResults, Converter={StaticResource BoolToVisibility}}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="清理" Width="52">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding Deletable}"
                                                      HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="名称" Width="200" DisplayMemberBinding="{Binding InferredName}" />
                                <GridViewColumn Header="大小" Width="120" DisplayMemberBinding="{Binding SizeText}" />
                                <GridViewColumn Header="最后写入" Width="110" DisplayMemberBinding="{Binding LastWriteText}" />
                                <GridViewColumn Header="路径" Width="480" DisplayMemberBinding="{Binding Path}" />
                                <GridViewColumn Header="说明" Width="260" DisplayMemberBinding="{Binding HintText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
