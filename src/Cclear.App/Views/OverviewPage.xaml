<UserControl x:Class="Cclear.App.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="C 盘空间" FontSize="18" FontWeight="Bold" />
            <ProgressBar Height="18" Minimum="0" Maximum="100" Value="{Binding UsedPercent}" Margin="0,8" />
            <TextBlock Text="{Binding DriveDetail}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="一键体检" Command="{Binding HealthCheckCommand}"
                        MinWidth="140" MinHeight="38" FontSize="14" FontWeight="SemiBold" />
                <Button Content="深度分析（大文件/类型统计）" Command="{Binding DeepScanCommand}"
                        Margin="10,0,0,0" MinHeight="38" />
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />

            <TextBlock Text="大文件 Top 50（≥100 MB）" FontSize="15" FontWeight="Bold" Margin="0,20,0,4" />
            <ListView ItemsSource="{Binding LargeFiles}" MaxHeight="280"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                        <GridViewColumn Header="文件" Width="640" DisplayMemberBinding="{Binding Path}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <TextBlock Text="空间占用类型排行（Top 15）" FontSize="15" FontWeight="Bold" Margin="0,16,0,4" />
            <ListView ItemsSource="{Binding Extensions}" MaxHeight="280"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="类型" Width="140" DisplayMemberBinding="{Binding Extension}" />
                        <GridViewColumn Header="占用" Width="110" DisplayMemberBinding="{Binding TotalText}" />
                        <GridViewColumn Header="文件数" Width="100" DisplayMemberBinding="{Binding Count}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</UserControl>
