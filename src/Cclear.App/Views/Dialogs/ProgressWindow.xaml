<ui:FluentWindow x:Class="Cclear.App.Views.Dialogs.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="正在清理…" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Closing="OnClosing">
    <StackPanel Margin="16">
        <TextBlock x:Name="CurrentFileText" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ProgressBar x:Name="Bar" Height="18" Margin="0,10" Minimum="0" Maximum="100" />
        <TextBlock x:Name="CountText" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Click="OnCancel" MinWidth="88" MinHeight="30" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
