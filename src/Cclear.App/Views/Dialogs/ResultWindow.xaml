<Window x:Class="Cclear.App.Views.Dialogs.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="清理结果" Width="640" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="FreedText" FontSize="20" FontWeight="Bold" Foreground="#2E7D32" />
        <TextBlock x:Name="DetailText" Margin="0,6,0,0" Foreground="#444" />
        <TextBlock x:Name="SkippedHeader" Text="跳过的文件（被占用/受保护）：" Margin="0,10,0,4"
                   FontWeight="SemiBold" Visibility="Collapsed" />
        <ListBox x:Name="SkippedList" Height="180" Visibility="Collapsed"
                 VirtualizingStackPanel.IsVirtualizing="True">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="LogPathText" Foreground="Gray" Margin="0,10,0,0"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="关闭" IsDefault="True" IsCancel="True" MinWidth="96" MinHeight="30" />
        </StackPanel>
    </StackPanel>
</Window>
