<UserControl x:Class="Cclear.App.Views.SpaceAnalysisPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="扫描位置：" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Margin="4,0" />
            <Button Grid.Column="2" Content="浏览…" Command="{Binding BrowseCommand}" Margin="0,0,4,0" MinWidth="64" />
            <Button Grid.Column="3" Content="开始扫描" Command="{Binding StartScanCommand}" Margin="0,0,4,0" MinWidth="88" />
            <Button Grid.Column="4" Content="取消" Command="{Binding CancelScanCommand}" MinWidth="64" />
        </Grid>

        <StatusBar DockPanel.Dock="Bottom">
            <ProgressBar Width="160" Height="14" IsIndeterminate="{Binding IsScanning}" />
            <Separator />
            <TextBlock Text="{Binding StatusText}" />
            <Separator />
            <TextBlock Text="{Binding ElapsedText}" Foreground="Gray" />
        </StatusBar>

        <TreeView ItemsSource="{Binding RootNodes}"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="{Binding Badge}" Foreground="OrangeRed" Margin="4,0,0,0" />
                        <TextBlock Text="{Binding SizeText}" Foreground="DarkSlateGray" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding CountText}" Foreground="Gray" Margin="12,0,0,0" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>
