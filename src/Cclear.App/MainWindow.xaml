<ui:FluentWindow x:Class="Cclear.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:Cclear.App.Views"
        Title="C-Clear — C 盘空间清理" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="C-Clear — C 盘空间清理" CanMaximize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="Nav" Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           OpenPaneLength="210"
                           HeaderVisibility="Collapsed">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="总览" Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type views:OverviewPage}"
                                       NavigationCacheMode="Enabled" />
                <ui:NavigationViewItem Content="空间分析" Icon="{ui:SymbolIcon DataUsage24}"
                                       TargetPageType="{x:Type views:SpaceAnalysisPage}"
                                       NavigationCacheMode="Enabled" />
                <ui:NavigationViewItem Content="清理清单" Icon="{ui:SymbolIcon TaskListLtr24}"
                                       TargetPageType="{x:Type views:CleanListPage}"
                                       NavigationCacheMode="Enabled" />
                <ui:NavigationViewItem Content="重复与空目录" Icon="{ui:SymbolIcon Copy24}"
                                       TargetPageType="{x:Type views:DuplicatesPage}"
                                       NavigationCacheMode="Enabled" />
                <ui:NavigationViewItem Content="深度清理" Icon="{ui:SymbolIcon Sparkle24}"
                                       TargetPageType="{x:Type views:DeepCleanPage}"
                                       NavigationCacheMode="Enabled" />
                <ui:NavigationViewItem Content="设置" Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type views:SettingsPage}"
                                       NavigationCacheMode="Enabled" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="1"
                              HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                              Margin="0,0,0,8" />
    </Grid>
</ui:FluentWindow>
