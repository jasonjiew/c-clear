<UserControl x:Class="Cclear.App.Views.CleanListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <DockPanel Margin="16">
        <!--  智能清理建议横幅（V3 P4，Pro 底座：未激活也可用）  -->
        <Border DockPanel.Dock="Top" Visibility="{Binding AdvisorBannerText, Converter={StaticResource TextToVisibility}}"
                Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                BorderThickness="0,0,0,0" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="一键应用推荐" Appearance="Primary"
                           Icon="{ui:SymbolIcon Wand24}" Command="{Binding ApplyRecommendationsCommand}"
                           MinWidth="130" MinHeight="32" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="18" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="智能建议" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="4"
                            Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding AdvisorIsPro, Converter={StaticResource BoolToInvisibility}}">
                        <TextBlock Text="Pro" FontSize="11" FontWeight="Bold" Foreground="White" />
                    </Border>
                    <TextBlock Text="{Binding AdvisorBannerText}" VerticalAlignment="Center" Margin="10,0,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               MaxWidth="640" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <ui:Button DockPanel.Dock="Right" Content="清理所选项（进入回收站）" Appearance="Primary"
                       Icon="{ui:SymbolIcon Broom24}" Command="{Binding ExecuteCleanCommand}"
                       MinWidth="190" MinHeight="36" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SummaryText}" FontSize="14" FontWeight="SemiBold"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>

        <!--  空状态：尚未体检或无可清理项（与列表叠放）  -->
        <Grid>
            <Border Visibility="{Binding Categories.Count, Converter={StaticResource EmptyStateVisibility}}"
                    VerticalAlignment="Top" Margin="0,80,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Broom24" FontSize="52" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="这里空空如也" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="到“总览”页点击“一键体检”，我会找出可以安全清理的内容。"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Margin="0,3" IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding LevelText}" Foreground="{Binding Level, Converter={StaticResource SafetyLevelToBrush}}"
                                                   FontWeight="Bold" Margin="10,0,0,0" />
                                        <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="10,0,0,0" />
                                        <TextBlock Text="{Binding FileCountText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="28,4,8,8">
                                    <TextBlock Text="{Binding Explanation}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <ListView ItemsSource="{Binding ItemsPreview}" MaxHeight="200" BorderThickness="0"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                                                <GridViewColumn Header="文件" Width="620" DisplayMemberBinding="{Binding Path}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <TextBlock Text="{Binding ItemsCountText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
