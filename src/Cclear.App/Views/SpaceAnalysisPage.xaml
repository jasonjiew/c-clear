<UserControl x:Class="Cclear.App.Views.SpaceAnalysisPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Cclear.App.Controls">
    <DockPanel Margin="12">
        <ui:Card DockPanel.Dock="Top" Margin="0,0,0,10" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                <TextBlock Text="扫描位置：" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Drives}" SelectedIndex="{Binding SelectedDriveIndex}"
                          DisplayMemberPath="DisplayText" MinWidth="150" VerticalAlignment="Center"
                          MinHeight="34" Margin="4,0" />
                <ui:TextBox Grid.Column="2" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                            VerticalAlignment="Center" Margin="4,0" MinHeight="34" />
                <ui:Button Grid.Column="3" Content="浏览…" Icon="{ui:SymbolIcon Folder24}"
                           Command="{Binding BrowseCommand}" Margin="4,0" />
                <ui:Button Grid.Column="4" Content="开始扫描" Appearance="Primary" Icon="{ui:SymbolIcon Search24}"
                           Command="{Binding StartScanCommand}" Margin="4,0" />
                <ui:Button Grid.Column="5" Content="取消" Command="{Binding CancelScanCommand}"
                           Margin="4,0,0,0" />
            </Grid>
        </ui:Card>

        <ui:Card DockPanel.Dock="Top" Margin="0,0,0,10" Padding="14,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding ThroughputText}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding ElapsedText}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
                <ProgressBar Height="6" Margin="0,8,0,0" IsIndeterminate="{Binding IsScanning}" />
            </StackPanel>
        </ui:Card>

        <ui:Card>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  工具行：视图切换 + 悬停信息  -->
                <DockPanel Grid.Row="0" Margin="2,0,2,6">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <RadioButton Content="空间矩形图" IsChecked="{Binding IsTreemapMode}" Margin="0,0,4,0" />
                        <RadioButton Content="目录树" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding TreemapStatsText}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="{Binding HoverInfoText}" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Right" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                </DockPanel>

                <!--  面包屑（矩形图模式）  -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Breadcrumb}"
                              Visibility="{Binding IsTreemapMode, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="›" Margin="2,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Button Content="{Binding Name}" Margin="2,0"
                                        Command="{Binding DataContext.JumpToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock x:Name="CrumbText" Text="{Binding Name}"
                                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                       Cursor="Hand" VerticalAlignment="Center" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CrumbText" Property="TextDecorations" Value="Underline" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter TargetName="CrumbText" Property="FontWeight" Value="SemiBold" />
                                                    <Setter TargetName="CrumbText" Property="Foreground"
                                                            Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  内容：矩形图（默认）/ 目录树  -->
                <Grid Grid.Row="2" MinHeight="380" Margin="0,6,0,0">
                    <Grid>
                        <controls:TreemapView x:Name="Treemap" ItemsSource="{Binding TreemapItems}"
                                              Visibility="{Binding IsTreemapMode, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Visibility="{Binding HasTreemapData, Converter={StaticResource BoolToInvisibility}}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="GridDots24" FontSize="34" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="完成扫描后，这里将以矩形树图展示空间占用（双击色块进入子目录）。"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,8,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TreeView ItemsSource="{Binding RootNodes}"
                              Visibility="{Binding IsTreemapMode, Converter={StaticResource BoolToInvisibility}}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="{Binding IconSymbol}" Margin="0,0,4,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Badge}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="4,0,0,0" />
                                    <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="12,0,0,0" />
                                    <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="12,0,0,0" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>

                <!--  图例（矩形图模式）  -->
                <ItemsControl Grid.Row="3" ItemsSource="{Binding LegendItems}" Margin="2,8,0,2"
                              Visibility="{Binding IsTreemapMode, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{Binding Brush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Extension}" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                <TextBlock Text="{Binding SizeText}" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ui:Card>
    </DockPanel>
</UserControl>
