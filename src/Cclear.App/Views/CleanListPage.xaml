<UserControl x:Class="Cclear.App.Views.CleanListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{Binding SummaryText}" FontSize="14" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,0,0,8" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Margin="0,3" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding LevelText}" Foreground="{Binding LevelBrush}"
                                               FontWeight="Bold" Margin="10,0,0,0" />
                                    <TextBlock Text="{Binding SizeText}" Foreground="DarkSlateGray" Margin="10,0,0,0" />
                                    <TextBlock Text="{Binding FileCountText}" Foreground="Gray" Margin="6,0,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="28,4,8,8">
                                <TextBlock Text="{Binding Explanation}" Foreground="#555" TextWrapping="Wrap" />
                                <ListView ItemsSource="{Binding ItemsPreview}" MaxHeight="200" BorderThickness="0"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                                            <GridViewColumn Header="文件" Width="620" DisplayMemberBinding="{Binding Path}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <TextBlock Text="{Binding ItemsCountText}" Foreground="Gray" Margin="0,4,0,0" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
