<UserControl x:Class="Cclear.App.Views.DuplicatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="分析目录：" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Margin="4,0" />
            <Button Grid.Column="2" Content="查找重复文件" Command="{Binding FindDuplicatesCommand}"
                    Margin="0,0,4,0" MinWidth="104" />
            <Button Grid.Column="3" Content="查找空目录" Command="{Binding FindEmptyDirsCommand}"
                    Margin="0,0,4,0" MinWidth="92" />
        </Grid>

        <StatusBar DockPanel.Dock="Bottom">
            <Button Content="删除勾选的重复文件" Command="{Binding DeleteDuplicatesCommand}" MinWidth="150" />
            <Separator />
            <Button Content="删除勾选的空目录" Command="{Binding DeleteEmptyDirsCommand}" MinWidth="140" />
            <Separator />
            <TextBlock Text="{Binding StatusText}" />
        </StatusBar>

        <TabControl>
            <TabItem Header="重复文件">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Groups}" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,2" IsExpanded="False">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedCountText}" Foreground="Gray" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Files}" Margin="24,2,0,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center"
                                                              ToolTip="勾选=删除；每组建议保留一份" />
                                                    <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" MinWidth="70" />
                                                    <TextBlock Text="{Binding LastWriteText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="8,0,0,0" MinWidth="120" />
                                                    <TextBlock Text="{Binding Path}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Path}" MaxWidth="640" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="空目录">
                <ListBox ItemsSource="{Binding EmptyDirs}"
                         VirtualizingStackPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Path}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Path}" MaxWidth="860" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
