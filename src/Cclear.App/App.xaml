<Application x:Class="Cclear.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:Cclear.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  WPF-UI Fluent 主题字典（启动时由 ThemeService 按设置覆盖为浅色/深色/跟随系统）  -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <converters:SafetyLevelToBrushConverter x:Key="SafetyLevelToBrush" />
            <converters:HealthScoreToBrushConverter x:Key="HealthScoreToBrush" />
            <converters:EmptyStateVisibilityConverter x:Key="EmptyStateVisibility" />
            <converters:BoolToInvisibilityConverter x:Key="BoolToInvisibility" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBoolConverter x:Key="InverseBool" />
            <converters:TextToVisibilityConverter x:Key="TextToVisibility" />

            <!--  GridView 列头主题化（默认模板深色下白底刺眼）  -->
            <Style TargetType="{x:Type GridViewColumnHeader}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,7">
                                <ContentPresenter VerticalAlignment="Center"
                                                  TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  ListView 背景透明化（默认白底在深色主题刺眼；容器 Card 提供背景）  -->
            <Style TargetType="{x:Type ListView}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style TargetType="{x:Type ListBox}">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            </Style>

            <!--  卡片 hover 抬升（V3 微交互：阴影随悬停出现，可点击的反馈暗示）  -->
            <Style TargetType="{x:Type ui:Card}" BasedOn="{StaticResource {x:Type ui:Card}}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                                                  Opacity="0.35" Color="#000000" />
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
