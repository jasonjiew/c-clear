<UserControl x:Class="Cclear.App.Views.Settings.SettingsLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <StackPanel Margin="8" MaxWidth="860" HorizontalAlignment="Left">
        <TextBlock Text="审计日志" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="每次清理都会写入 JSONL 审计日志（时间、规则、路径、字节、结果），所有删除均可回查。"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal">
            <ui:Button Content="打开日志文件夹" Icon="{ui:SymbolIcon Folder24}"
                       Command="{Binding OpenLogsFolderCommand}" MinWidth="140" MinHeight="34" Appearance="Primary" />
            <ui:Button Content="导出本周 HTML 周报" Icon="{ui:SymbolIcon Document24}"
                       Command="{Binding ExportWeeklyReportCommand}" MinWidth="160" MinHeight="34" Margin="8,0,0,0" />
            <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2"
                    Margin="8,0,0,0" VerticalAlignment="Center"
                    Visibility="{Binding ReportIsPro, Converter={StaticResource BoolToInvisibility}}">
                <TextBlock Text="Pro" FontSize="11" FontWeight="Bold" Foreground="White" />
            </Border>
            <TextBlock Text="{Binding ReportStatusText}" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <TextBlock Text="清理历史（最近 30 天）" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,0" />
        <Grid Margin="0,4,0,0">
            <TextBlock Text="{Binding HistorySummaryText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:Button Content="刷新" Icon="{ui:SymbolIcon ArrowClockwise24}" HorizontalAlignment="Right"
                       Command="{Binding RefreshHistoryCommand}" MinWidth="76" />
        </Grid>
        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                Margin="0,10,0,0" Padding="6" MinHeight="152">
            <!--  高度 ≥150px：LiveCharts2 在更矮的可用高度下 Y 轴测量错乱（实测阈值）  -->
            <lvc:CartesianChart Series="{Binding HistoryChart.Series}" XAxes="{Binding HistoryChart.XAxes}"
                                YAxes="{Binding HistoryChart.YAxes}" MinHeight="140" Background="Transparent"
                                TooltipPosition="Top" AnimationsSpeed="00:00:00.25" />
        </Border>
    </StackPanel>
</UserControl>
