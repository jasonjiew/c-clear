<UserControl x:Class="Cclear.App.Views.Settings.SettingsLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Margin="8" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="审计日志" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="每次清理都会写入 JSONL 审计日志（时间、规则、路径、字节、结果），所有删除均可回查。"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal">
            <ui:Button Content="打开日志文件夹" Icon="{ui:SymbolIcon Folder24}"
                       Command="{Binding OpenLogsFolderCommand}" MinWidth="140" MinHeight="34" Appearance="Primary" />
            <TextBlock Text="{Binding LogsFolder}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </StackPanel>
</UserControl>
