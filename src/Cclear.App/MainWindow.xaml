<Window x:Class="Cclear.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Cclear.App.ViewModels"
        xmlns:views="clr-namespace:Cclear.App.Views"
        Title="C-Clear — C 盘空间清理" Height="680" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}">
            <views:SpaceAnalysisPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanListViewModel}">
            <views:CleanListPage />
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <ListBox DockPanel.Dock="Left" Width="150" ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding CurrentPage}" DisplayMemberPath="Title"
                 Background="#F4F5F7" BorderThickness="0,0,1,0" FontSize="14" />
        <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>
</Window>
